{
  "name": "claude-switcher",
  "displayName": "[JACR] Claude Deepseek Switcher",
  "description": "Seamlessly switch between Anthropic Claude and Deepseek AI models in Claude Code without leaving VS Code.",
  "version": "1.2.0",
  "icon": "images/icon.png",
  "publisher": "shivampip",
  "author": {
    "name": "jacr",
    "email": "jacr@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shivampip/claude-deepseek-switcher"
  },
  "homepage": "https://github.com/shivampip/claude-deepseek-switcher#readme",
  "bugs": {
    "url": "https://github.com/shivampip/claude-deepseek-switcher/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "deepseek",
    "ai",
    "llm",
    "switcher"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claude-deepseek-switcher.switchModel",
        "title": "Claude Deepseek Switcher: Switch Model"
      },
      {
        "command": "claude-deepseek-switcher.resetDeepseekApiKey",
        "title": "Claude Deepseek Switcher: Reset Deepseek API Key"
      }
    ],
    "configuration": {
      "title": "Claude Deepseek Switcher",
      "properties": {
        "claudeDeepseekSwitcher.statusBarAlignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right",
          "description": "Position of the status bar item"
        }
      }
    },
    "keybindings": [
      {
        "command": "claude-deepseek-switcher.switchModel",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorFocus"
      }
    ]
  },
  "scripts": {
    "test": "node --test deepseek-rate.test.js extension.test.js",
    "lint": "eslint .",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.23.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Dedicated AI terminals can expose credentials to workspace processes."
    }
  }
}
